#!/bin/bash
#SBATCH --job-name=das_final_qwen72b
#SBATCH --output=logs/das_final_qwen_72b_it_%j.out
#SBATCH --error=logs/das_final_qwen_72b_it_%j.err
#SBATCH --partition=gpu_h100
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=16
#SBATCH --gpus=4
#SBATCH --mem=256G
#SBATCH --time=24:00:00

mkdir -p logs results
# Cluster-specific (Snellius): replace the module and source lines with your own environment.
module purge
module load 2023
module load Python/3.11.3-GCCcore-12.3.0
module load CUDA/12.1.1
source "$HOME/envs/das/bin/activate"
cd "$SLURM_SUBMIT_DIR"
export PYTHONPATH="$(cd "$SLURM_SUBMIT_DIR/.." && pwd):$PYTHONPATH"
echo "Job ID: $SLURM_JOB_ID  Node: $SLURMD_NODENAME  Started: $(date)"

PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True \
DAS_MODEL=Qwen/Qwen2.5-72B-Instruct \
METAPHOR_DATA=../data/gut-2016-new.csv \
DAS_K_VALUES=16,32 \
FORCE_LAYER=52 \
BATCH_SIZE=2 \
DAS_BATCH=4 \
python -u metaphor_das.py

echo "Exit code: $?  Done: $(date)"
