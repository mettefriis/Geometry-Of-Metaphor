#!/bin/bash
#SBATCH --job-name=steer_final_gemma9b
#SBATCH --output=logs/steer_class_final_gemma_9b_it_%j.out
#SBATCH --error=logs/steer_class_final_gemma_9b_it_%j.err
#SBATCH --partition=gpu_h100
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=4
#SBATCH --gpus=1
#SBATCH --mem=40G
#SBATCH --time=12:00:00

mkdir -p logs results
# Cluster-specific (Snellius): replace the module and source lines with your own environment.
module purge
module load 2023
module load Python/3.11.3-GCCcore-12.3.0
module load CUDA/12.1.1
source "$HOME/envs/das/bin/activate"
cd "$SLURM_SUBMIT_DIR"
echo "Job ID: $SLURM_JOB_ID  Node: $SLURMD_NODENAME  Started: $(date)"

MODEL_TAG="google_gemma_2_9b_it"
DAS_JSON="../01_domain_general_das/results/results_metaphor_das_final_${MODEL_TAG}.json"
BEST_LAYER=$(python3 -c "import json; print(json.load(open('${DAS_JSON}'))['best_layer'])")
BEST_K=$(python3 -c "import json; print(json.load(open('${DAS_JSON}'))['best_k'])")
echo "Using BEST_LAYER=${BEST_LAYER}  BEST_K=${BEST_K}"

DAS_MODEL=google/gemma-2-9b-it \
R_GLOBAL_PATH=../01_domain_general_das/results/R_metaphor_final_k${BEST_K}_${MODEL_TAG}.npy \
BEST_LAYER=${BEST_LAYER} \
ALPHAS=1 \
METAPHOR_DATA=../data/gut-2016-new.csv \
python -u metaphor_steer_classification.py

echo "Exit code: $?  Done: $(date)"
