#!/bin/bash
#SBATCH --job-name=gen_final_llama70b
#SBATCH --output=logs/generation_final_llama_70b_it_%j.out
#SBATCH --error=logs/generation_final_llama_70b_it_%j.err
#SBATCH --partition=gpu_h100
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=16
#SBATCH --gpus=4
#SBATCH --mem=256G
#SBATCH --time=24:00:00

mkdir -p logs results
module purge
module load 2023
module load Python/3.11.3-GCCcore-12.3.0
module load CUDA/12.1.1
source "$HOME/envs/das/bin/activate"
cd "$SLURM_SUBMIT_DIR"
echo "Job ID: $SLURM_JOB_ID  Node: $SLURMD_NODENAME  Started: $(date)"

MODEL_TAG="meta_llama_llama_3.1_70b_instruct"
DAS_JSON="../01_domain_general_das/results/results_metaphor_das_final_${MODEL_TAG}.json"
BEST_LAYER=$(python3 -c "import json; print(json.load(open('${DAS_JSON}'))['best_layer'])")
BEST_K=$(python3 -c "import json; print(json.load(open('${DAS_JSON}'))['best_k'])")
echo "Using BEST_LAYER=${BEST_LAYER}  BEST_K=${BEST_K}"

PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True \
DAS_MODEL=meta-llama/Llama-3.1-70B-Instruct \
R_MATRIX_PATH=../01_domain_general_das/results/R_metaphor_final_k${BEST_K}_${MODEL_TAG}.npy \
BEST_LAYER=${BEST_LAYER} \
STEER_DIRS=met,lit \
ALPHAS=1,2,5,10 \
N_GEN_EXAMPLES=100 \
METAPHOR_DATA=../data/gut-2016-new.csv \
python -u metaphor_self_verb_steer.py

echo "Exit code: $?  Done: $(date)"
