#!/bin/bash
#SBATCH --job-name=judge_final_mistral7b
#SBATCH --output=logs/judge_final_mistral_7b_it_%j.out
#SBATCH --error=logs/judge_final_mistral_7b_it_%j.err
#SBATCH --partition=gpu_h100
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=8
#SBATCH --gpus=2
#SBATCH --mem=160G
#SBATCH --time=08:00:00

mkdir -p logs results/judge
module purge
module load 2023
module load Python/3.11.3-GCCcore-12.3.0
module load CUDA/12.1.1
source "$HOME/envs/das/bin/activate"
cd "$SLURM_SUBMIT_DIR"
echo "Job ID: $SLURM_JOB_ID  Node: $SLURMD_NODENAME  Started: $(date)"

JUDGE_MODEL=Qwen/Qwen2.5-72B-Instruct \
RESULTS_GLOB="../04_generation/results/results_metaphor_generation_final_*mistralai_mistral_7b_instruct_v0.3*.json" \
RESULTS_OUT_DIR=results/judge \
REPEAT_THRESHOLD=3 \
python -u metaphor_llm_judge_local.py

echo "Exit code: $?  Done: $(date)"
